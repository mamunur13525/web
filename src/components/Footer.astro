---
import { Connects } from "@/data/demo/connects";

const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<footer class="relative w-full mt-24 h-fit overflow-hidden">
  {/* Decorative Elements */}
  <div
    class="absolute top-0 left-0 w-full h-px bg-linear-to-r from-transparent via-border to-transparent"
  >
  </div>

  <div class="relative z-10 py-12">
    <div class="max-w-4xl mx-auto">
      {/* Main Footer Content */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
        {/* Brand Section */}
        <div class="space-y-4">
          <h3 class="text-2xl font-bold text-foreground font-stack">
            Mamun Ahmed
          </h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Full Stack Developer crafting exceptional digital experiences with
            modern technologies.
          </p>
          <div class="flex items-center gap-2 text-muted-foreground text-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path
                d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
              ></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Dhaka, Bangladesh</span>
          </div>
        </div>

        {/* Quick Links */}
        <div class="space-y-4">
          <h4
            class="text-sm font-semibold text-foreground uppercase tracking-wider"
          >
            Quick Links
          </h4>
          <ul class="space-y-2">
            {
              quickLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="group flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors duration-200 text-sm"
                  >
                    <span class="group-hover:translate-x-1 transition-transform duration-200">
                      {link.label}
                    </span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                    >
                      <path d="M7 7h10v10" />
                      <path d="M7 17 17 7" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {/* Connect Section */}
        <div class="space-y-4">
          <h4
            class="text-sm font-semibold text-foreground uppercase tracking-wider"
          >
            Connect
          </h4>
          <div class="flex flex-wrap gap-3">
            {
              Connects.map((connect) => (
                <a
                  href={connect.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group relative w-10 h-10 rounded-lg bg-muted/50 hover:bg-muted border border-border hover:border-muted-foreground/30 transition-all duration-300 flex items-center justify-center overflow-hidden"
                  title={connect.name}
                >
                  <img
                    src={connect.icon}
                    alt={connect.name}
                    width="20"
                    height="20"
                    loading="lazy"
                    decoding="async"
                    class="w-5 h-5 opacity-70 group-hover:opacity-100 group-hover:scale-125 transition-all duration-300 rounded-sm"
                  />
                </a>
              ))
            }
          </div>
          <a
            href="mailto:mamun.ahmed13525@gmail.com"
            class="group flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors duration-200 text-sm mt-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path>
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            </svg>
            <span class="group-hover:underline underline-offset-2">
              mamun.ahmed13525@gmail.com
            </span>
          </a>
        </div>
      </div>

      {/* Divider */}
      <div
        class="w-full h-px bg-linear-to-r from-transparent via-border to-transparent mb-8"
      >
      </div>

      {/* Bottom Section */}
      <div
        class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-muted-foreground"
      >
        <p class="text-center md:text-left">
          © {currentYear} Mamun Ahmed. All rights reserved.
        </p>
      </div>

      {/* Large Text Background */}
      <div
        class="absolute bottom-8 left-1/2 -translate-x-1/2 pointer-events-none scale-y-170"
      >
        <span
          class="text-8xl md:text-9xl font-bold text-foreground/5 whitespace-nowrap font-stack"
        >
          Full Stack
          <span class="hidden sm:inline"> Dev.</span>
        </span>
      </div>
    </div>
  </div>
</footer>
