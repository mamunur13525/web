---
import AccordionIcon from "../ui/AccordionIcon.astro";
import type { ProjectType } from "@/types/types";
import { renderMarkdown } from "@/lib/markdown";

interface Props {
  project: ProjectType;
}

const { project } = Astro.props;
const contentHtml = renderMarkdown(project.content, "project");
---

<div
  class="project-card border border-border bg-white/60 dark:bg-[#141416]/60 backdrop-blur-lg transition-all duration-300"
>
  <button
    type="button"
    class="project-trigger group w-full text-left cursor-pointer outline-none"
    aria-expanded="false"
  >
    <!-- Thumbnail -->
    <div class="relative overflow-hidden w-full">
      {project.image.thumbnail ? (
        <img
          src={project.image.thumbnail}
          alt={project.title}
          loading="lazy"
          decoding="async"
          class="w-full aspect-video object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="aspect-video bg-secondary flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-12 h-12 text-muted-foreground/40"
          >
            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
            <circle cx="9" cy="9" r="2"></circle>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
          </svg>
        </div>
      )}
    </div>

    <!-- Title + Date + Short Description row -->
    <div class="flex items-start justify-between gap-4 px-5 py-4 border-t border-border">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-lg font-semibold text-foreground truncate">
            {project.title}
          </h3>
          <span class="text-xs text-muted-foreground font-normal shrink-0">
            {project.date}
          </span>
        </div>
        {project.short_description && (
          <p class="mt-2 text-sm text-muted-foreground line-clamp-2 leading-relaxed">
            {project.short_description}
          </p>
        )}
      </div>
      <div
        class="text-muted-foreground pointer-events-none size-4 shrink-0 translate-y-1 transition-transform duration-200 project-chevron"
      >
        <AccordionIcon />
      </div>
    </div>
  </button>

  <!-- Expanded details -->
  <div class="project-content overflow-hidden border-t border-border" hidden>
    <div class="px-5 py-4 space-y-4">
      {project.content && (
        <div
          class="prose prose-zinc max-w-none text-sm text-muted-foreground [&_p]:text-sm [&_p]:leading-relaxed [&_p]:mb-2 [&_ul]:mb-2 [&_li]:text-sm [&_h2]:text-xs [&_h2]:uppercase [&_h2]:tracking-wider [&_h2]:mb-2 [&_h2]:mt-4 [&_h2]:font-medium"
        >
          <Fragment set:html={contentHtml} />
        </div>
      )}

      {project.type.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {project.type.map((type) => (
            <span class="px-2.5 py-0.5 rounded-full bg-secondary text-muted-foreground text-xs font-medium border border-border">
              {type}
            </span>
          ))}
        </div>
      )}

      <div class="flex items-center gap-4 pt-1">
        {project.live.preview && (
          <a
            href={project.live.preview}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path d="M9 17H7A5 5 0 0 1 7 7h2" />
              <path d="M15 7h2a5 5 0 1 1 0 10h-2" />
              <line x1="8" x2="16" y1="12" y2="12" />
            </svg>
            Live Preview
          </a>
        )}
        {project.live.git && (
          <a
            href={project.live.git}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
            aria-label="Frontend Code"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
            Frontend
          </a>
        )}
        {(project.live as any).backend && (
          <a
            href={(project.live as any).backend}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
            aria-label="Backend Code"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
            Backend
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .project-card[data-expanded="true"] .project-chevron {
    transform: translateY(0.5) rotate(180deg);
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
      if (card.dataset.ready) return;
      card.dataset.ready = "true";

      const trigger = card.querySelector<HTMLElement>(".project-trigger");
      const content = card.querySelector<HTMLElement>(".project-content");
      if (!trigger || !content) return;

      trigger.addEventListener("click", (e) => {
        /* Don't toggle when clicking a link inside the trigger */
        if ((e.target as HTMLElement).closest(".project-link")) return;

        const expanded =
          trigger.getAttribute("aria-expanded") === "true";
        trigger.setAttribute("aria-expanded", String(!expanded));
        content.hidden = expanded;
        card.dataset.expanded = String(!expanded);
      });
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>