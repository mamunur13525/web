---
/**
 * Floating AI assistant. The React version called a server action; here the
 * client posts to `/api/chat` instead. Markdown in replies is rendered by
 * `marked` on the server and returned as HTML.
 */
---

<!-- Chat Toggle Button - Fixed Position -->
<button
  id="ai-chat-toggle"
  type="button"
  class="btn btn-square fixed z-300 transition-[transform,opacity] duration-300 ease-out will-change-transform w-16 h-16 min-h-0 rounded-full shadow-2xl bg-zinc-900 dark:bg-white hover:bg-zinc-800 dark:hover:bg-zinc-100 border border-zinc-700 dark:border-zinc-300 hover:scale-110 active:scale-95 backdrop-blur-md bottom-6 right-6 md:bottom-8 md:right-8 cursor-pointer"
  aria-label="Open AI Chat"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="w-7 h-7 text-white dark:text-zinc-900"
  >
    <path d="M12 8V4H8"></path>
    <rect width="16" height="12" x="4" y="8" rx="2"></rect>
    <path d="M2 14h2"></path>
    <path d="M20 14h2"></path>
    <path d="M15 13v2"></path>
    <path d="M9 13v2"></path>
  </svg>
  <span
    class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-green-500 rounded-full border-2 border-white dark:border-zinc-900 animate-pulse"
  ></span>
</button>

<!-- Chat Window -->
<div
  id="ai-chat-window"
  class="fixed z-400 transition-[opacity,transform] duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform inset-0 md:inset-auto md:bottom-8 md:right-8 md:w-[420px] md:h-[600px] md:rounded-2xl overflow-hidden shadow-2xl opacity-0 scale-95 pointer-events-none translate-y-4"
>
  <!-- Background with glassmorphism -->
  <div
    class="absolute inset-0 bg-white/80 dark:bg-zinc-950/90 backdrop-blur-2xl"
  >
  </div>

  <!-- Subtle border -->
  <div
    class="absolute inset-0 border border-zinc-200/50 dark:border-zinc-800/50 md:rounded-2xl"
  >
  </div>

  <!-- Content -->
  <div class="relative h-full flex flex-col">
    <!-- Header -->
    <div class="relative">
      <div
        class="absolute inset-0 bg-linear-to-r from-zinc-50/50 to-transparent dark:from-zinc-900/50 dark:to-transparent"
      >
      </div>

      <div
        class="relative flex items-center justify-between p-5 md:p-5 md:py-4 border-b border-zinc-200/80 dark:border-zinc-800/80"
      >
        <div class="flex items-center gap-4">
          <div class="relative">
            <!-- Animated pulse ring -->
            <div
              class="absolute inset-0 rounded-full bg-zinc-900 dark:bg-white animate-ping opacity-20"
            >
            </div>
            <div
              class="relative w-12 h-12 rounded-full bg-zinc-900 dark:bg-white flex items-center justify-center shadow-lg"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-6 h-6 text-white dark:text-zinc-900"
              >
                <path d="M12 8V4H8"></path>
                <rect width="16" height="12" x="4" y="8" rx="2"></rect>
                <path d="M2 14h2"></path>
                <path d="M20 14h2"></path>
                <path d="M15 13v2"></path>
                <path d="M9 13v2"></path>
              </svg>
            </div>
            <span
              class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-green-500 rounded-full border-2 border-white dark:border-zinc-950 shadow-sm"
            ></span>
          </div>
          <div>
            <h3
              class="font-bold text-base text-zinc-900 dark:text-white tracking-tight"
            >
              AI Assistant
            </h3>
            <p
              class="text-xs text-zinc-500 dark:text-zinc-400 font-medium mt-0.5 flex items-center gap-1.5"
            >
              <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"
              ></span>
              Online now
            </p>
          </div>
        </div>
        <button
          id="ai-chat-close"
          type="button"
          class="btn btn-ghost btn-square w-10 h-10 min-h-0 rounded-full hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all duration-300 hover:rotate-90"
          aria-label="Close chat"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-5 h-5"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages -->
    <div
      id="ai-chat-messages"
      class="chat-scroll flex-1 overflow-y-auto p-4 md:p-5 space-y-4 relative scroll-smooth"
    >
      <div id="ai-chat-anchor"></div>
    </div>

    <!-- Input -->
    <div
      class="p-4 md:p-5 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 backdrop-blur-sm"
    >
      <div class="flex gap-3 items-center">
        <div class="flex-1 relative">
          <!-- Scroll to bottom button -->
          <div
            id="ai-chat-scroll-btn-wrap"
            class="absolute -top-20 left-1/2 translate-x-[30%] transition-all duration-300 z-10 opacity-0 translate-y-4 pointer-events-none"
          >
            <button
              id="ai-chat-scroll-btn"
              type="button"
              class="btn btn-square border rounded-full w-10 h-10 min-h-0 bg-white/90 dark:bg-zinc-800/90 shadow-lg border-zinc-200 dark:border-zinc-700 hover:scale-110 transition-transform cursor-pointer"
              aria-label="Scroll to latest message"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-6 h-6 text-zinc-900 dark:text-white"
              >
                <path d="M12 5v14"></path>
                <path d="m19 12-7 7-7-7"></path>
              </svg>
            </button>
          </div>
          <textarea
            id="ai-chat-input"
            rows="1"
            placeholder="Type your message..."
            class="textarea w-full min-h-[48px] max-h-[150px] rounded-2xl px-5 py-3 bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-700 focus:border-zinc-900 dark:focus:border-white focus:outline-none focus:ring-4 focus:ring-zinc-900/10 dark:focus:ring-white/10 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 text-zinc-900 dark:text-white font-medium transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed resize-none overflow-y-auto"
          ></textarea>
        </div>
        <button
          id="ai-chat-send"
          type="button"
          disabled
          class="btn btn-square w-12 h-12 min-h-0 rounded-2xl shrink-0 bg-zinc-900 dark:bg-white hover:bg-zinc-800 dark:hover:bg-zinc-100 border-2 border-zinc-900 dark:border-white disabled:opacity-30 disabled:cursor-not-allowed transition-all duration-300 hover:scale-105 active:scale-95 shadow-lg hover:shadow-xl"
          aria-label="Send message"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-5 h-5 text-white dark:text-zinc-900"
          >
            <path
              d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"
            ></path>
            <path d="m21.854 2.147-10.94 10.939"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  interface Message {
    id: string;
    role: "user" | "assistant";
    content: string;
    html: string;
    timestamp: Date;
  }

  const DEFAULT_MESSAGE: Message = {
    id: "default-1",
    role: "assistant",
    content:
      "👋 Hi! I'm your AI assistant for this portfolio. Ask me anything about Mamun's work, skills, or projects!",
    html: "<p>👋 Hi! I'm your AI assistant for this portfolio. Ask me anything about Mamun's work, skills, or projects!</p>",
    timestamp: new Date(),
  };

  function init() {
    const toggle = document.getElementById("ai-chat-toggle");
    const windowEl = document.getElementById("ai-chat-window");
    const closeBtn = document.getElementById("ai-chat-close");
    const list = document.getElementById("ai-chat-messages");
    const anchor = document.getElementById("ai-chat-anchor");
    const input = document.getElementById("ai-chat-input") as HTMLTextAreaElement;
    const sendBtn = document.getElementById("ai-chat-send") as HTMLButtonElement;
    const scrollWrap = document.getElementById("ai-chat-scroll-btn-wrap");
    const scrollBtn = document.getElementById("ai-chat-scroll-btn");

    if (
      !toggle || !windowEl || !closeBtn || !list || !anchor ||
      !input || !sendBtn || !scrollWrap || !scrollBtn
    ) {
      return;
    }
    if (toggle.dataset.ready) return;
    toggle.dataset.ready = "true";

    let messages: Message[] = [DEFAULT_MESSAGE];
    let isOpen = false;
    let isLoading = false;

    const escapeHtml = (s: string) =>
      s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

    function renderMessages() {
      const html = messages
        .map((message, index) => {
          const isUser = message.role === "user";
          const bubble = isUser
            ? "bg-zinc-900/95 dark:bg-zinc-300/95 text-white dark:text-zinc-900 rounded-br-sm border-zinc-700 dark:border-zinc-300"
            : "bg-zinc-100/80 dark:bg-zinc-800/80 text-zinc-900 dark:text-white rounded-bl-sm border-zinc-200 dark:border-zinc-700";
          const textTone = isUser
            ? "text-white dark:text-zinc-900"
            : "text-zinc-900 dark:text-white";
          const timeTone = isUser
            ? "text-white/60 dark:text-zinc-900/60"
            : "text-zinc-500 dark:text-zinc-400";
          const time = message.timestamp.toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit",
          });

          return `
            <div class="message-animate flex ${isUser ? "justify-end" : "justify-start"}"
                 style="animation-delay: ${index * 100}ms">
              <div class="max-w-[85%] rounded-2xl px-5 pb-3.5 shadow-lg backdrop-blur-sm transition-all duration-300 hover:shadow-xl border ${bubble}">
                <div class="text-sm leading-relaxed font-medium prose ${textTone}">
                  ${message.html}
                </div>
                <span class="text-[10px] mt-2 block font-medium ${timeTone}">${time}</span>
              </div>
            </div>`;
        })
        .join("");

      const loader = isLoading
        ? `<div class="flex justify-start message-animate">
             <div class="bg-zinc-100/80 dark:bg-zinc-800/80 backdrop-blur-sm rounded-2xl rounded-bl-sm px-5 py-3.5 shadow-lg border border-zinc-200 dark:border-zinc-700">
               <div class="flex gap-1.5">
                 <span class="w-2.5 h-2.5 bg-zinc-900 dark:bg-white rounded-full animate-bounce [animation-delay:0ms]"></span>
                 <span class="w-2.5 h-2.5 bg-zinc-900 dark:bg-white rounded-full animate-bounce [animation-delay:150ms]"></span>
                 <span class="w-2.5 h-2.5 bg-zinc-900 dark:bg-white rounded-full animate-bounce [animation-delay:300ms]"></span>
               </div>
             </div>
           </div>`
        : "";

      list!.innerHTML = html + loader + '<div id="ai-chat-anchor"></div>';
    }

    function scrollToBottom() {
      document
        .getElementById("ai-chat-anchor")
        ?.scrollIntoView({ behavior: "smooth" });
      scrollWrap!.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
      scrollWrap!.classList.remove("opacity-100", "translate-y-0");
    }

    list.addEventListener("scroll", () => {
      const { scrollTop, scrollHeight, clientHeight } = list;
      const atBottom = scrollHeight - scrollTop - clientHeight < 100;
      scrollWrap.classList.toggle("opacity-0", atBottom);
      scrollWrap.classList.toggle("translate-y-4", atBottom);
      scrollWrap.classList.toggle("pointer-events-none", atBottom);
      scrollWrap.classList.toggle("opacity-100", !atBottom);
      scrollWrap.classList.toggle("translate-y-0", !atBottom);
    });

    scrollBtn.addEventListener("click", scrollToBottom);

    function setOpen(open: boolean) {
      isOpen = open;
      toggle!.classList.toggle("scale-0", open);
      toggle!.classList.toggle("opacity-0", open);
      toggle!.classList.toggle("pointer-events-none", open);

      windowEl!.classList.toggle("opacity-100", open);
      windowEl!.classList.toggle("scale-100", open);
      windowEl!.classList.toggle("pointer-events-auto", open);
      windowEl!.classList.toggle("translate-y-0", open);
      windowEl!.classList.toggle("opacity-0", !open);
      windowEl!.classList.toggle("scale-95", !open);
      windowEl!.classList.toggle("pointer-events-none", !open);
      windowEl!.classList.toggle("translate-y-4", !open);

      if (open) setTimeout(scrollToBottom, 100);
    }

    toggle.addEventListener("click", () => setOpen(!isOpen));
    closeBtn.addEventListener("click", () => setOpen(false));

    // Auto-resize the textarea, mirroring the React effect
    input.addEventListener("input", () => {
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 150)}px`;
      sendBtn.disabled = !input.value.trim() || isLoading;
    });

    async function sendMessage() {
      const value = input.value.trim();
      if (!value || isLoading) return;

      messages.push({
        id: `user-${Date.now()}`,
        role: "user",
        content: value,
        html: `<p>${escapeHtml(value)}</p>`,
        timestamp: new Date(),
      });

      input.value = "";
      input.style.height = "auto";
      isLoading = true;
      input.disabled = true;
      sendBtn.disabled = true;
      renderMessages();
      setTimeout(scrollToBottom, 500);

      try {
        const response = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            messages: messages.map((m) => ({
              role: m.role,
              content: m.content,
            })),
          }),
        });

        const result = await response.json();

        messages.push({
          id: `ai-${Date.now()}`,
          role: "assistant",
          content: result.text ?? "",
          html: result.html || "<p>Sorry, I couldn't generate a response.</p>",
          timestamp: new Date(),
        });
      } catch (error) {
        console.error("Chat Error:", error);
        messages.push({
          id: `ai-error-${Date.now()}`,
          role: "assistant",
          content: "Sorry, something went wrong. Please try again.",
          html: "<p>Sorry, something went wrong. Please try again.</p>",
          timestamp: new Date(),
        });
      } finally {
        isLoading = false;
        input.disabled = false;
        sendBtn.disabled = !input.value.trim();
        renderMessages();
        setTimeout(scrollToBottom, 100);
      }
    }

    sendBtn.addEventListener("click", sendMessage);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    renderMessages();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
