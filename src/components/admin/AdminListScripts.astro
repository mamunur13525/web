---
/**
 * Client-side helpers shared by the admin list pages.
 *
 * - `#admin-search` filters `[data-row]` elements by their `data-search` text.
 * - `[data-delete-url]` buttons send a DELETE request and remove the matching
 *   `[data-row-id]` element.
 * - `[data-reorder-table]` tables get drag-to-reorder on `[data-drag-handle]`
 *   grips: dragging a row reorders the DOM and persists the id sequence to
 *   the endpoint in `data-reorder-url` (`PUT`, `{ ids: [...] }`).
 */
---

<script>
  function initAdminList() {
    const search = document.getElementById("admin-search") as HTMLInputElement | null;
    const noResults = document.getElementById("admin-search-empty");
    const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-row]"));

    if (search && !search.dataset.ready) {
      search.dataset.ready = "true";
      search.addEventListener("input", () => {
        const term = search.value.trim().toLowerCase();
        let visible = 0;

        rows.forEach((row) => {
          const match =
            !term || (row.dataset.search ?? "").toLowerCase().includes(term);
          row.classList.toggle("hidden", !match);
          if (match) visible += 1;
        });

        noResults?.classList.toggle("hidden", visible > 0 || rows.length === 0);
      });
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-delete-url]")
      .forEach((button) => {
        if (button.dataset.ready) return;
        button.dataset.ready = "true";

        button.addEventListener("click", async () => {
          const url = button.dataset.deleteUrl;
          if (!url) return;

          const label = button.dataset.deleteLabel ?? "this item";
          if (!window.confirm(`Delete ${label}? This cannot be undone.`)) return;

          button.setAttribute("disabled", "true");

          try {
            const response = await fetch(url, {
              method: "DELETE",
              /* A JSON content type keeps Astro's cross-origin form check happy */
              headers: { "Content-Type": "application/json" },
            });
            const payload = await response.json().catch(() => null);

            if (!response.ok) {
              throw new Error(payload?.error ?? "Delete failed");
            }

            window.toast?.success("Deleted successfully");

            document
              .querySelector(`[data-row-id="${button.dataset.rowId}"]`)
              ?.remove();

            if (document.querySelectorAll("[data-row]").length === 0) {
              window.location.reload();
            }
          } catch (error) {
            window.toast?.error(
              error instanceof Error ? error.message : "Delete failed"
            );
            button.removeAttribute("disabled");
          }
        });
      });

    document
      .querySelectorAll<HTMLElement>("[data-reorder-table]")
      .forEach((table) => {
        if (table.dataset.ready) return;
        table.dataset.ready = "true";

        const url = table.dataset.reorderUrl;
        if (!url) return;

        const tbody = table.querySelector("tbody");
        if (!tbody) return;

        const rows = () =>
          Array.from(tbody.querySelectorAll<HTMLElement>("[data-row]"));

        const status = document.getElementById("admin-reorder-status");
        let saveTimer: ReturnType<typeof setTimeout> | null = null;
        let clearStatusTimer: ReturnType<typeof setTimeout> | null = null;

        const announce = (message: string, isError = false) => {
          if (!status) return;
          if (clearStatusTimer) clearTimeout(clearStatusTimer);

          const icon = isError
            ? `<span class="inline-block size-2 rounded-full bg-destructive shrink-0"></span>`
            : message.includes("✓")
            ? `<span class="inline-block text-emerald-500 font-bold shrink-0">✓</span>`
            : `<span class="inline-block size-2 rounded-full bg-amber-500 animate-pulse shrink-0"></span>`;

          status.innerHTML = `<div class="flex items-center gap-2">${icon}<span>${message}</span></div>`;
          status.classList.remove("hidden");
          status.dataset.state = isError ? "error" : "ok";
          status.classList.toggle("border-destructive/40", isError);
          status.classList.toggle("bg-destructive/10", isError);
          status.classList.toggle("text-destructive", isError);
          status.classList.toggle("border-border", !isError);
          status.classList.toggle("text-muted-foreground", !isError);

          if (!isError && message.includes("✓")) {
            clearStatusTimer = setTimeout(() => {
              status.classList.add("hidden");
            }, 4000);
          }
        };

        const persist = () => {
          const ids = rows()
            .map((row) => row.dataset.rowId ?? "")
            .filter(Boolean);
          announce("Saving new order…");
          fetch(url, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ids }),
          })
            .then(async (response) => {
              const payload = await response.json().catch(() => null);
              if (!response.ok) {
                throw new Error(payload?.error ?? "Could not save the order");
              }
              announce("Order saved ✓ — display order updated.");
              window.toast?.success("Order saved");
            })
            .catch((error: unknown) => {
              announce(
                error instanceof Error ? error.message : "Could not save order",
                true
              );
              window.toast?.error("Could not save the new order");
            });
        };

        const schedulePersist = () => {
          if (saveTimer) clearTimeout(saveTimer);
          saveTimer = setTimeout(persist, 500);
        };

        const setupRow = (row: HTMLElement) => {
          const handle = row.querySelector<HTMLElement>("[data-drag-handle]");
          if (!handle || handle.dataset.handleReady) return;
          handle.dataset.handleReady = "true";

          // Accessible keyboard reordering
          handle.addEventListener("keydown", (e: KeyboardEvent) => {
            if (e.key !== "ArrowUp" && e.key !== "ArrowDown") return;
            e.preventDefault();

            if (search && search.value.trim().length > 0) {
              window.toast?.info("Please clear search before reordering");
              return;
            }

            const currentRows = rows();
            const currentIndex = currentRows.indexOf(row);
            if (currentIndex === -1) return;

            const title = row.dataset.rowTitle || "Project";

            if (e.key === "ArrowUp" && currentIndex > 0) {
              const prevRow = currentRows[currentIndex - 1];
              tbody.insertBefore(row, prevRow);
              row.classList.add("bg-primary/10");
              setTimeout(() => row.classList.remove("bg-primary/10"), 600);
              handle.focus();
              announce(`Moved "${title}" up to #${currentIndex}`);
              schedulePersist();
            } else if (e.key === "ArrowDown" && currentIndex < currentRows.length - 1) {
              const nextRow = currentRows[currentIndex + 1];
              tbody.insertBefore(row, nextRow.nextElementSibling);
              row.classList.add("bg-primary/10");
              setTimeout(() => row.classList.remove("bg-primary/10"), 600);
              handle.focus();
              announce(`Moved "${title}" down to #${currentIndex + 2}`);
              schedulePersist();
            }
          });

          // Pointer-based drag & drop
          handle.addEventListener("pointerdown", (e: PointerEvent) => {
            if (e.button !== 0) return;

            if (search && search.value.trim().length > 0) {
              window.toast?.info("Please clear search before reordering");
              return;
            }

            const startX = e.clientX;
            const startY = e.clientY;
            let isDragging = false;
            let ghost: HTMLElement | null = null;
            let indicator: HTMLElement | null = null;
            let dropTarget: { targetRow: HTMLElement; position: "before" | "after" } | null = null;

            handle.setPointerCapture(e.pointerId);

            const onPointerMove = (moveEvent: PointerEvent) => {
              if (!isDragging) {
                if (Math.hypot(moveEvent.clientX - startX, moveEvent.clientY - startY) < 5) {
                  return;
                }
                isDragging = true;
                row.classList.add("opacity-40", "bg-muted/40");
                document.body.style.cursor = "grabbing";
                document.body.style.userSelect = "none";

                // Floating drag preview
                ghost = document.createElement("div");
                ghost.className =
                  "pointer-events-none fixed z-50 flex items-center gap-2.5 rounded-lg border border-primary/50 bg-background/95 px-3 py-2 text-xs font-semibold shadow-2xl backdrop-blur-md ring-2 ring-primary/20";
                const img = row.querySelector<HTMLImageElement>("img");
                const title = row.dataset.rowTitle || "Project";
                ghost.innerHTML = `
                  ${img ? `<span class="size-6 shrink-0 overflow-hidden rounded border border-border bg-muted"><img src="${img.src}" class="size-full object-cover" /></span>` : ""}
                  <span class="max-w-[200px] truncate text-foreground">${title}</span>
                `;
                ghost.style.left = `${moveEvent.clientX + 16}px`;
                ghost.style.top = `${moveEvent.clientY + 12}px`;
                document.body.appendChild(ghost);

                // Drop indicator line
                indicator = document.createElement("tr");
                indicator.className = "pointer-events-none select-none transition-all";
                indicator.innerHTML = `
                  <td colspan="5" class="p-0">
                    <div class="h-1 w-full bg-primary rounded-full shadow-[0_0_8px_rgba(var(--color-primary),0.6)] my-0.5 animate-pulse"></div>
                  </td>
                `;
              }

              if (ghost) {
                ghost.style.left = `${moveEvent.clientX + 16}px`;
                ghost.style.top = `${moveEvent.clientY + 12}px`;
              }

              const clientY = moveEvent.clientY;
              const allRows = rows().filter((r) => r !== row);
              let found = false;

              for (const otherRow of allRows) {
                const rect = otherRow.getBoundingClientRect();
                if (clientY >= rect.top && clientY <= rect.bottom) {
                  const middle = rect.top + rect.height / 2;
                  const pos = clientY < middle ? "before" : "after";
                  dropTarget = { targetRow: otherRow, position: pos };
                  found = true;

                  if (indicator) {
                    if (pos === "before") {
                      tbody.insertBefore(indicator, otherRow);
                    } else {
                      tbody.insertBefore(indicator, otherRow.nextElementSibling);
                    }
                  }
                  break;
                }
              }

              if (!found && allRows.length > 0 && indicator) {
                const firstRect = allRows[0].getBoundingClientRect();
                const lastRect = allRows[allRows.length - 1].getBoundingClientRect();
                if (clientY < firstRect.top) {
                  dropTarget = { targetRow: allRows[0], position: "before" };
                  tbody.insertBefore(indicator, allRows[0]);
                } else if (clientY > lastRect.bottom) {
                  dropTarget = { targetRow: allRows[allRows.length - 1], position: "after" };
                  tbody.appendChild(indicator);
                }
              }
            };

            const onPointerUp = (upEvent: PointerEvent) => {
              handle.releasePointerCapture(upEvent.pointerId);
              handle.removeEventListener("pointermove", onPointerMove);
              handle.removeEventListener("pointerup", onPointerUp);
              handle.removeEventListener("pointercancel", onPointerUp);

              document.body.style.cursor = "";
              document.body.style.userSelect = "";
              row.classList.remove("opacity-40", "bg-muted/40");

              if (ghost) {
                ghost.remove();
                ghost = null;
              }

              if (isDragging && indicator && dropTarget) {
                const { targetRow, position } = dropTarget;
                const oldIndex = rows().indexOf(row);

                if (position === "before") {
                  tbody.insertBefore(row, targetRow);
                } else {
                  tbody.insertBefore(row, targetRow.nextElementSibling);
                }

                indicator.remove();
                indicator = null;

                const newIndex = rows().indexOf(row);
                if (oldIndex !== newIndex) {
                  row.classList.add("bg-primary/10");
                  setTimeout(() => row.classList.remove("bg-primary/10"), 600);
                  schedulePersist();
                }
              } else if (indicator) {
                indicator.remove();
                indicator = null;
              }
            };

            handle.addEventListener("pointermove", onPointerMove);
            handle.addEventListener("pointerup", onPointerUp);
            handle.addEventListener("pointercancel", onPointerUp);
          });
        };

        rows().forEach(setupRow);
      });
  }

  initAdminList();
  document.addEventListener("astro:page-load", initAdminList);
</script>
