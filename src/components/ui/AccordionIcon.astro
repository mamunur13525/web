---
/**
 * Chevron pair used as the accordion indicator. The paths swap direction
 * when the surrounding `group` element is open (`aria-expanded="true"`).
 */
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="w-4 h-4 accordion-icon"
>
  <path class="accordion-icon-top transition-all duration-300" d="M7 9L12 4L17 9"></path>
  <path class="accordion-icon-bottom transition-all duration-300" d="M7 15L12 20L17 15"></path>
</svg>

<style is:global>
  [data-state="open"] .accordion-icon-top {
    d: path("M7 4L12 9L17 4");
  }
  [data-state="open"] .accordion-icon-bottom {
    d: path("M7 20L12 15L17 20");
  }
</style>
