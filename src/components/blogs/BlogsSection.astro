---
import SectionTitle from "../ui/SectionTitle.astro";
import SingleBlog from "./SingleBlog.astro";
import connectDB from "@/lib/mongodb";
import Blog from "@/models/Blog";
import type { BlogType } from "@/types/types";

/**
 * Homepage teaser: the 4 newest posts from the `blogs` collection.
 * Astro renders this on the server, so the list is present in the
 * initial HTML; only the error branch remains.
 */
let blogs: BlogType[] = [];
let error: string | null = null;

try {
  await connectDB();
  const docs = await Blog.find({})
    .select("title slug excerpt category image date")
    .sort({ order: 1, date: -1 })
    .limit(4)
    .lean();
  blogs = JSON.parse(JSON.stringify(docs)) as BlogType[];
} catch (err) {
  console.error("Error fetching blogs:", err);
  error = err instanceof Error ? err.message : "An error occurred";
}
---

<SectionTitle title="Blogs">
  {
    error && (
      <div class="mt-10 p-6 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
        <p class="text-red-600 dark:text-red-400">
          Error loading blogs: {error}
        </p>
      </div>
    )
  }

  {
    !error && blogs.length === 0 && (
      <div class="mt-10 text-center py-10">
        <p class="text-muted-foreground">
          No blogs yet. Add one from the{" "}
          <a href="/admin/blogs" class="underline">
            admin panel
          </a>
          .
        </p>
      </div>
    )
  }

  {
    !error && blogs.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-5">
        {blogs.map((blog) => (
          <SingleBlog blog={blog} />
        ))}
      </div>
    )
  }
</SectionTitle>
