---
import SectionTitle from "../ui/SectionTitle.astro";

/**
 * Homepage teaser: the 4 newest posts from the `blogs` collection.
 *
 * The section renders an **instant static shell** (skeleton cards) with no
 * database work; the client script at the bottom fetches `/api/blogs`
 * right after paint and builds the cards from the response.
 */
const SKELETON_CARDS = Array.from({ length: 4 });
---

<SectionTitle title="Blogs">
  {/* Error / empty state, revealed by the client script. */}
  <div id="blogs-status" hidden>
    <div id="blogs-status-box" class="mt-10 text-center py-10"></div>
  </div>

  {/* Skeleton cards — replaced by the fetched posts. */}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-5" id="blogs-list">
    {
      SKELETON_CARDS.map(() => (
        <div class="blog-card border border-border bg-white/60 dark:bg-[#141416]/60 backdrop-blur-lg animate-pulse">
          <div class="aspect-video w-full bg-muted" />
          <div class="flex items-center justify-between gap-4 border-t border-border px-5 py-4">
            <div class="min-w-0 w-full space-y-2">
              <div class="h-5 w-3/4 rounded bg-muted" />
              <div class="h-4 w-1/3 rounded bg-muted" />
            </div>
          </div>
          <div class="space-y-4 border-t border-border px-5 py-4">
            <div class="h-4 w-full rounded bg-muted" />
            <div class="h-4 w-2/3 rounded bg-muted" />
            <div class="h-4 w-28 rounded bg-muted" />
          </div>
        </div>
      ))
    }
  </div>
</SectionTitle>

<script>
  import type { BlogType } from "@/types/types";

  /** `/api/blogs` list response. */
  type ListPayload = { success: boolean; data?: BlogType[] };

  const TEASER_COUNT = 4;

  const listEl = document.getElementById("blogs-list")!;
  const statusEl = document.getElementById("blogs-status")!;
  const statusBoxEl = document.getElementById("blogs-status-box")!;

  /** Escapes data before it is interpolated into markup. */
  function esc(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  /** Error / empty state — mirrors the two branches the server used to render. */
  function showStatus(kind: "error" | "empty", message?: string) {
    if (kind === "error") {
      statusBoxEl.className =
        "mt-10 p-6 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg";
      statusBoxEl.innerHTML = `<p class="text-red-600 dark:text-red-400">Error loading blogs: ${esc(
        message ?? "An error occurred"
      )}</p>`;
    } else {
      statusBoxEl.className = "mt-10 text-center py-10";
      statusBoxEl.innerHTML = `<p class="text-muted-foreground">No blogs.</p>`;
    }
    statusEl.removeAttribute("hidden");
  }

  /** Blog card — same markup as `<SingleBlog />` (card variant). */
  function cardHtml(blog: BlogType): string {
    const href = blog.slug ? `/blog/${encodeURIComponent(blog.slug)}` : "#";
    const cover = blog.image
      ? `<img src="${esc(blog.image)}" alt="${esc(blog.title)}" loading="lazy" decoding="async" class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105" />`
      : `<div class="flex aspect-video items-center justify-center bg-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12 text-muted-foreground/40"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /></svg></div>`;

    return `<div class="blog-card border border-border bg-white/60 dark:bg-[#141416]/60 backdrop-blur-lg transition-all duration-300">
      <a href="${href}" class="group block w-full text-left outline-none">
        <div class="relative w-full overflow-hidden">${cover}</div>
        <div class="flex items-center justify-between gap-4 border-t border-border px-5 py-4">
          <div class="min-w-0">
            <h3 class="truncate text-lg font-semibold text-foreground group-hover:text-primary group-hover:underline">${esc(blog.title)}</h3>
            <span class="block truncate text-sm font-normal text-muted-foreground">${esc(blog.date ?? "")}</span>
          </div>
          <span class="pointer-events-none size-4 shrink-0 translate-y-0.5 text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></span>
        </div>
      </a>
      <div class="space-y-4 border-t border-border px-5 py-4">
        ${
          blog.excerpt
            ? `<p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground">${esc(blog.excerpt)}</p>`
            : ""
        }
        ${
          blog.category
            ? `<div class="flex flex-wrap gap-1.5"><span class="rounded-full border border-border bg-secondary px-2.5 py-0.5 text-xs font-medium text-muted-foreground">${esc(blog.category)}</span></div>`
            : ""
        }
        <div class="flex items-center gap-4 pt-1">
          <a href="${href}" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline" aria-label="Read ${esc(blog.title || "article")}">Read article <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></a>
        </div>
      </div>
    </div>`;
  }

  async function load() {
    try {
      const response = await fetch("/api/blogs", {
        headers: { Accept: "application/json" },
      });
      if (!response.ok) {
        throw new Error(`Failed to fetch blogs (${response.status})`);
      }
      const payload = (await response.json()) as ListPayload;
      if (!payload.success) throw new Error("Failed to fetch blogs");

      const blogs = (payload.data ?? []).slice(0, TEASER_COUNT);
      if (blogs.length === 0) {
        listEl.style.display = "none";
        showStatus("empty");
        return;
      }

      listEl.innerHTML = blogs.map(cardHtml).join("");
    } catch (error) {
      console.error("Error fetching blogs:", error);
      listEl.style.display = "none";
      showStatus("error", error instanceof Error ? error.message : undefined);
    }
  }

  void load();
</script>
