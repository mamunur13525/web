---
/**
 * Contact form. Validation mirrors the original zod schema, but runs in the
 * browser; submission posts to `/api/contact`.
 */
---

<div
  class="card relative border-4 p-0 border-white dark:border-zinc-800 shadow-2xl shadow-zinc-400/20 dark:shadow-zinc-900/50 rounded-4xl min-h-[270px] h-auto w-full bg-white dark:bg-zinc-900 overflow-hidden sm:col-span-2 mt-10"
>
  <div class="p-6">
    <h1 class="text-full font-medium mb-10 dark:text-white">Send Email:</h1>
    <form
      id="contact-form"
      class="grid grid-cols-1 gap-4 md:grid-cols-2"
      novalidate
    >
      <div class="col-span-1">
        <label class="label mb-2 text-sm font-medium" for="contact-name">
          Name
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          placeholder="Your name"
          class="input w-full py-6 h-auto rounded-full border border-input bg-transparent dark:bg-zinc-800 dark:border-zinc-700 dark:text-white dark:placeholder:text-zinc-400 focus:outline-none focus:border-ring focus:ring-[3px] focus:ring-ring/50"
        />
        <p class="error-message text-sm text-destructive mt-1 hidden" data-for="name"></p>
      </div>

      <div class="col-span-1">
        <label class="label mb-2 text-sm font-medium" for="contact-email">
          Email
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          placeholder="you@example.com"
          class="input w-full py-6 h-auto rounded-full border border-input bg-transparent dark:bg-zinc-800 dark:border-zinc-700 dark:text-white dark:placeholder:text-zinc-400 focus:outline-none focus:border-ring focus:ring-[3px] focus:ring-ring/50"
        />
        <p class="error-message text-sm text-destructive mt-1 hidden" data-for="email"></p>
      </div>

      <div class="col-span-1 md:col-span-2">
        <label class="label mb-2 text-sm font-medium" for="contact-message">
          Message
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="6"
          placeholder="Write your message"
          class="textarea w-full rounded-2xl border bg-transparent dark:bg-zinc-800 px-3 py-2 text-base outline-none placeholder:text-muted-foreground border-input dark:border-zinc-700 dark:text-white dark:placeholder:text-zinc-400 focus:border-ring focus:ring-ring/50 focus:ring-[3px]"
        ></textarea>
        <p class="error-message text-sm text-destructive mt-1 hidden" data-for="message"></p>
      </div>

      <div class="col-span-1 md:col-span-2 flex justify-end">
        <button
          id="contact-submit"
          class="btn px-6 py-6 h-auto min-h-0 rounded-full cursor-pointer bg-[#000000] text-white border-none dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200 transition-colors gap-2"
          type="submit"
        >
          <span class="submit-idle flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path
                d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"
              ></path>
              <path d="m21.854 2.147-10.94 10.939"></path>
            </svg>
            Send message
          </span>
          <span class="submit-loading hidden items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4 animate-spin"
            >
              <path d="M12 2v4"></path>
              <path d="m16.2 7.8 2.9-2.9"></path>
              <path d="M18 12h4"></path>
              <path d="m16.2 16.2 2.9 2.9"></path>
              <path d="M12 18v4"></path>
              <path d="m4.9 19.1 2.9-2.9"></path>
              <path d="M2 12h4"></path>
              <path d="m4.9 4.9 2.9 2.9"></path>
            </svg>
            Sending...
          </span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function init() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "true";

    const submit = document.getElementById("contact-submit") as HTMLButtonElement;
    const idle = submit.querySelector(".submit-idle") as HTMLElement;
    const loading = submit.querySelector(".submit-loading") as HTMLElement;

    const setError = (field: string, message: string | null) => {
      const el = form.querySelector<HTMLElement>(`.error-message[data-for="${field}"]`);
      const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
      if (!el) return;
      if (message) {
        el.textContent = message;
        el.classList.remove("hidden");
        input?.setAttribute("aria-invalid", "true");
      } else {
        el.textContent = "";
        el.classList.add("hidden");
        input?.setAttribute("aria-invalid", "false");
      }
    };

    /* Same rules as the original zod schema */
    const validate = (values: Record<string, string>) => {
      const errors: Record<string, string> = {};
      if (!values.name) errors.name = "Name is required";
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email))
        errors.email = "Invalid email address";
      if (values.message.length < 10)
        errors.message = "Message should be at least 10 characters";
      return errors;
    };

    const setSubmitting = (state: boolean) => {
      submit.disabled = state;
      idle.classList.toggle("hidden", state);
      idle.classList.toggle("flex", !state);
      loading.classList.toggle("hidden", !state);
      loading.classList.toggle("flex", state);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const values = {
        name: String(data.get("name") ?? "").trim(),
        email: String(data.get("email") ?? "").trim(),
        message: String(data.get("message") ?? "").trim(),
      };

      const errors = validate(values);
      ["name", "email", "message"].forEach((field) =>
        setError(field, errors[field] ?? null)
      );
      if (Object.keys(errors).length > 0) return;

      setSubmitting(true);
      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(values),
        });

        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Something went wrong");

        if (result.success) {
          window.toast?.success("Message sent!", {
            description: "Thanks for reaching out. I'll get back to you soon.",
          });
        } else {
          window.toast?.error("Failed to send message", {
            description: "Please try again later or email me directly.",
          });
        }
        form.reset();
      } catch (err) {
        console.error(err);
        window.toast?.error("Failed to send message", {
          description: "Please try again later or email me directly.",
        });
      } finally {
        setSubmitting(false);
      }
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
