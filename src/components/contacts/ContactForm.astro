---
/**
 * Contact form. Validation mirrors the original zod schema, but runs in the
 * browser; submission posts to `/api/contact`.
 */
---

<div
  class="w-full border border-border bg-white/60 dark:bg-[#141416]/60 backdrop-blur-lg rounded-none p-6"
>
  <form
    id="contact-form"
    class="grid grid-cols-1 gap-5 md:grid-cols-2"
    novalidate
  >
    <div class="col-span-1">
      <label
        class="block mb-2 text-sm font-medium text-foreground"
        for="contact-name"
      >
        Name
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        placeholder="Your name"
        class="w-full rounded-none border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-ring focus:ring-[3px] focus:ring-ring/50 transition-colors"
      />
      <p
        class="error-message text-sm text-destructive mt-1 hidden"
        data-for="name"
      >
      </p>
    </div>

    <div class="col-span-1">
      <label
        class="block mb-2 text-sm font-medium text-foreground"
        for="contact-email"
      >
        Email
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        placeholder="you@example.com"
        class="w-full rounded-none border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-ring focus:ring-[3px] focus:ring-ring/50 transition-colors"
      />
      <p
        class="error-message text-sm text-destructive mt-1 hidden"
        data-for="email"
      >
      </p>
    </div>

    <div class="col-span-1 md:col-span-2">
      <label
        class="block mb-2 text-sm font-medium text-foreground"
        for="contact-message"
      >
        Message
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        placeholder="Write your message"
        class="w-full rounded-none border border-border bg-background px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-ring focus:ring-[3px] focus:ring-ring/50 transition-colors resize-y"
      ></textarea>
      <p
        class="error-message text-sm text-destructive mt-1 hidden"
        data-for="message"
      >
      </p>
    </div>

    <div class="col-span-1 md:col-span-2 flex justify-end">
      <button
        id="contact-submit"
        class="btn btn-outline min-w-[160px] h-10 min-h-0 cursor-pointer gap-2 rounded-none border border-border bg-primary text-primary-content hover:bg-primary/90 text-sm font-medium transition-colors"
        type="submit"
      >
        <span class="submit-idle flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
          >
            <path
              d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"
            ></path>
            <path d="m21.854 2.147-10.94 10.939"></path>
          </svg>
          Send message
        </span>
        <span class="submit-loading hidden items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4 animate-spin"
          >
            <path d="M12 2v4"></path>
            <path d="m16.2 7.8 2.9-2.9"></path>
            <path d="M18 12h4"></path>
            <path d="m16.2 16.2 2.9 2.9"></path>
            <path d="M12 18v4"></path>
            <path d="m4.9 19.1 2.9-2.9"></path>
            <path d="M2 12h4"></path>
            <path d="m4.9 4.9 2.9 2.9"></path>
          </svg>
          Sending...
        </span>
      </button>
    </div>
  </form>

  <!-- Direct Contact Links: Email, WhatsApp, X -->
  <div class="mt-10 pt-8 border-t border-border">
    <div class="flex items-center justify-between mb-4">
      <h2
        class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"
      >
        Or reach out directly
      </h2>
      <span class="text-xs text-muted-foreground"
        >Available for work &amp; collaboration</span
      >
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Email -->
      <a
        href="mailto:mamun.ahmed13525@gmail.com"
        class="group flex items-center gap-4 px-3 py-3 rounded-none border hover:bg-accent transition-colors duration-200 no-underline"
      >
        <div
          class="shrink-0 w-10 h-10 rounded-none bg-background border border-border flex items-center justify-center text-foreground group-hover:scale-110 transition-transform duration-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <h3
            class="text-sm font-semibold text-foreground group-hover:underline"
          >
            Email
          </h3>
          <p class="text-xs text-muted-foreground truncate">
            mamun.ahmed13525@gmail.com
          </p>
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4 text-muted-foreground group-hover:text-foreground transition-colors shrink-0"
        >
          <path d="M7 7h10v10"></path>
          <path d="M7 17 17 7"></path>
        </svg>
      </a>

      <!-- WhatsApp -->
      <a
        href="https://wa.me/?text=Hi%20Mamun,%20I%20found%20your%20portfolio"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 px-3 py-3 rounded-none border hover:bg-accent transition-colors duration-200 no-underline"
      >
        <div
          class="shrink-0 w-10 h-10 rounded-none bg-background border border-border flex items-center justify-center group-hover:scale-110 transition-transform duration-200"
        >
          <svg
            viewBox="0 0 48 48"
            class="w-6 h-6"
            version="1.1"
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
          >
            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
            <g
              id="SVGRepo_tracerCarrier"
              stroke-linecap="round"
              stroke-linejoin="round"></g>
            <g id="SVGRepo_iconCarrier">
              <title>Whatsapp-color</title>
              <desc>Created with Sketch.</desc>
              <defs></defs>
              <g
                id="Icons"
                stroke="none"
                stroke-width="1"
                fill="none"
                fill-rule="evenodd"
              >
                <g
                  id="Color-"
                  transform="translate(-700.000000, -360.000000)"
                  fill="#67C15E"
                >
                  <path
                    d="M723.993033,360 C710.762252,360 700,370.765287 700,383.999801 C700,389.248451 701.692661,394.116025 704.570026,398.066947 L701.579605,406.983798 L710.804449,404.035539 C714.598605,406.546975 719.126434,408 724.006967,408 C737.237748,408 748,397.234315 748,384.000199 C748,370.765685 737.237748,360.000398 724.006967,360.000398 L723.993033,360.000398 L723.993033,360 Z M717.29285,372.190836 C716.827488,371.07628 716.474784,371.034071 715.769774,371.005401 C715.529728,370.991464 715.262214,370.977527 714.96564,370.977527 C714.04845,370.977527 713.089462,371.245514 712.511043,371.838033 C711.806033,372.557577 710.056843,374.23638 710.056843,377.679202 C710.056843,381.122023 712.567571,384.451756 712.905944,384.917648 C713.258648,385.382743 717.800808,392.55031 724.853297,395.471492 C730.368379,397.757149 732.00491,397.545307 733.260074,397.27732 C735.093658,396.882308 737.393002,395.527239 737.971421,393.891043 C738.54984,392.25405 738.54984,390.857171 738.380255,390.560912 C738.211068,390.264652 737.745308,390.095816 737.040298,389.742615 C736.335288,389.389811 732.90737,387.696673 732.25849,387.470894 C731.623543,387.231179 731.017259,387.315995 730.537963,387.99333 C729.860819,388.938653 729.198006,389.89831 728.661785,390.476494 C728.238619,390.928051 727.547144,390.984595 726.969123,390.744481 C726.193254,390.420348 724.021298,389.657798 721.340985,387.273388 C719.267356,385.42535 717.856938,383.125756 717.448104,382.434484 C717.038871,381.729275 717.405907,381.319529 717.729948,380.938852 C718.082653,380.501232 718.421026,380.191036 718.77373,379.781688 C719.126434,379.372738 719.323884,379.160897 719.549599,378.681068 C719.789645,378.215575 719.62006,377.735746 719.450874,377.382942 C719.281687,377.030139 717.871269,373.587317 717.29285,372.190836 Z"
                    id="Whatsapp"></path>
                </g>
              </g>
            </g>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <h3
            class="text-sm font-semibold text-foreground group-hover:underline"
          >
            WhatsApp
          </h3>
          <p class="text-xs text-muted-foreground truncate">Chat on WhatsApp</p>
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4 text-muted-foreground group-hover:text-foreground transition-colors shrink-0"
        >
          <path d="M7 7h10v10"></path>
          <path d="M7 17 17 7"></path>
        </svg>
      </a>

      <!-- X -->
      <a
        href="https://x.com/Mamun13525"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 px-3 py-3 rounded-none border hover:bg-accent transition-colors duration-200 no-underline"
      >
        <div
          class="shrink-0 w-10 h-10 rounded-none bg-background border border-border flex items-center justify-center text-foreground group-hover:scale-110 transition-transform duration-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="text-foreground"
          >
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <h3
            class="text-sm font-semibold text-foreground group-hover:underline"
          >
            X
          </h3>
          <p class="text-xs text-muted-foreground truncate">@Mamun13525</p>
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4 text-muted-foreground group-hover:text-foreground transition-colors shrink-0"
        >
          <path d="M7 7h10v10"></path>
          <path d="M7 17 17 7"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  function init() {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "true";

    const submit = document.getElementById(
      "contact-submit",
    ) as HTMLButtonElement;
    const idle = submit.querySelector(".submit-idle") as HTMLElement;
    const loading = submit.querySelector(".submit-loading") as HTMLElement;

    const setError = (field: string, message: string | null) => {
      const el = form.querySelector<HTMLElement>(
        `.error-message[data-for="${field}"]`,
      );
      const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
      if (!el) return;
      if (message) {
        el.textContent = message;
        el.classList.remove("hidden");
        input?.setAttribute("aria-invalid", "true");
      } else {
        el.textContent = "";
        el.classList.add("hidden");
        input?.setAttribute("aria-invalid", "false");
      }
    };

    /* Same rules as the original zod schema */
    const validate = (values: Record<string, string>) => {
      const errors: Record<string, string> = {};
      if (!values.name) errors.name = "Name is required";
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email))
        errors.email = "Invalid email address";
      if (values.message.length < 10)
        errors.message = "Message should be at least 10 characters";
      return errors;
    };

    const setSubmitting = (state: boolean) => {
      submit.disabled = state;
      idle.classList.toggle("hidden", state);
      idle.classList.toggle("flex", !state);
      loading.classList.toggle("hidden", !state);
      loading.classList.toggle("flex", state);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const values = {
        name: String(data.get("name") ?? "").trim(),
        email: String(data.get("email") ?? "").trim(),
        message: String(data.get("message") ?? "").trim(),
      };

      const errors = validate(values);
      ["name", "email", "message"].forEach((field) =>
        setError(field, errors[field] ?? null),
      );
      if (Object.keys(errors).length > 0) return;

      setSubmitting(true);
      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(values),
        });

        const result = await response.json();
        if (!response.ok)
          throw new Error(result.error || "Something went wrong");

        if (result.success) {
          window.toast?.success("Message sent!", {
            description: "Thanks for reaching out. I'll get back to you soon.",
          });
        } else {
          window.toast?.error("Failed to send message", {
            description: "Please try again later or email me directly.",
          });
        }
        form.reset();
      } catch (err) {
        console.error(err);
        window.toast?.error("Failed to send message", {
          description: "Please try again later or email me directly.",
        });
      } finally {
        setSubmitting(false);
      }
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
