---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Not Found" description="The page you are looking for does not exist.">
  <main class="min-h-[50vh] flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold mb-4 font-stack">Page Not Found</h1>
      <p class="text-muted-foreground mb-6">
        The page you are looking for does not exist.
      </p>
      <a href="/" class="text-primary hover:underline">Back to home</a>
    </div>
  </main>
</Layout>
