---
import AdminLayout from "@/layouts/AdminLayout.astro";
import BlogForm from "@/components/admin/BlogForm.astro";

export const prerender = false;
---

<AdminLayout title="New blog" active="blogs">
  <div class="space-y-6">
    <header>
      <a
        href="/admin/blogs"
        class="text-sm text-muted-foreground no-underline hover:underline"
      >
        ← Blogs
      </a>
      <h1 class="mt-2 font-stack text-2xl font-semibold">New blog post</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Published immediately to <a href="/blogs" class="text-primary no-underline hover:underline">/blogs</a>.
      </p>
    </header>

    <BlogForm />
  </div>
</AdminLayout>
