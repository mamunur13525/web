---
import AdminLayout from "@/layouts/AdminLayout.astro";
import connectDB from "@/lib/mongodb";
import Project from "@/models/Project";
import Blog from "@/models/Blog";
import { formatDate } from "@/lib/utils";
import type { AdminProjectType, BlogType } from "@/types/types";

export const prerender = false;

let error: string | null = null;
let projectCount = 0;
let blogCount = 0;
let recentProjects: AdminProjectType[] = [];
let recentBlogs: BlogType[] = [];

try {
  await connectDB();

  [projectCount, blogCount] = await Promise.all([
    Project.countDocuments(),
    Blog.countDocuments(),
  ]);

  recentProjects = JSON.parse(
    JSON.stringify(await Project.find({}).sort({ order: 1, date: -1 }).limit(5).lean())
  ) as AdminProjectType[];

  recentBlogs = JSON.parse(
    JSON.stringify(
      await Blog.find({})
        .select("title slug category date")
        .sort({ order: 1, date: -1 })
        .limit(5)
        .lean()
    )
  ) as BlogType[];
} catch (err) {
  console.error("Error loading dashboard:", err);
  error = err instanceof Error ? err.message : "Unknown error";
}

const cardClass = "rounded-2xl border border-border bg-background p-5";
---

<AdminLayout title="Dashboard" active="dashboard">
  <div class="space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-stack text-2xl font-semibold">Dashboard</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          Manage the projects and blog posts stored in MongoDB.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href="/admin/projects/new"
          class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground no-underline transition-opacity hover:opacity-90"
        >
          + New project
        </a>
        <a
          href="/admin/blogs/new"
          class="rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold no-underline transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          + New blog
        </a>
      </div>
    </header>

    {
      error && (
        <div class="rounded-2xl border border-destructive/40 bg-destructive/10 p-4 text-sm text-destructive">
          <p class="font-semibold">Could not reach MongoDB</p>
          <p class="mt-1 break-words opacity-90">{error}</p>
          <p class="mt-2 opacity-90">
            Set <code>MONGODB_URI</code> in your <code>.env</code> file and restart
            the dev server.
          </p>
        </div>
      )
    }

    <div class="grid gap-4 sm:grid-cols-2">
      <div class={cardClass}>
        <p class="text-sm text-muted-foreground">Projects</p>
        <p class="mt-2 text-3xl font-semibold">{projectCount}</p>
        <a
          href="/admin/projects"
          class="mt-3 inline-block text-sm font-medium text-primary no-underline hover:underline"
        >
          Manage projects →
        </a>
      </div>

      <div class={cardClass}>
        <p class="text-sm text-muted-foreground">Blog posts</p>
        <p class="mt-2 text-3xl font-semibold">{blogCount}</p>
        <a
          href="/admin/blogs"
          class="mt-3 inline-block text-sm font-medium text-primary no-underline hover:underline"
        >
          Manage blogs →
        </a>
      </div>
    </div>

    {
      !error && (
        <div class="grid gap-4 lg:grid-cols-2">
          <section class={cardClass}>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
              Latest projects
            </h2>

            {recentProjects.length === 0 ? (
              <p class="mt-3 text-sm text-muted-foreground">
                No projects yet.{" "}
                <a
                  href="/admin/projects/new"
                  class="text-primary no-underline hover:underline"
                >
                  Add your first project
                </a>
                .
              </p>
            ) : (
              <ul class="mt-3 space-y-3">
                {recentProjects.map((project) => (
                  <li class="flex items-center gap-3">
                    <span class="size-9 shrink-0 overflow-hidden rounded-md border border-border bg-muted">
                      {project.image?.preview ? (
                        <img
                          src={project.image.preview}
                          alt=""
                          class="size-full object-cover"
                          loading="lazy"
                        />
                      ) : null}
                    </span>
                    <span class="min-w-0 flex-1">
                      <a
                        href={`/admin/projects/edit/${project._id}`}
                        class="block truncate text-sm font-medium no-underline hover:underline"
                      >
                        {project.title}
                      </a>
                      <span class="text-xs text-muted-foreground">
                        {formatDate(project.date)}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class={cardClass}>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
              Latest blog posts
            </h2>

            {recentBlogs.length === 0 ? (
              <p class="mt-3 text-sm text-muted-foreground">
                No blog posts yet.{" "}
                <a
                  href="/admin/blogs/new"
                  class="text-primary no-underline hover:underline"
                >
                  Write your first post
                </a>
                .
              </p>
            ) : (
              <ul class="mt-3 space-y-3">
                {recentBlogs.map((blog) => (
                  <li class="flex items-center justify-between gap-3">
                    <span class="min-w-0 flex-1">
                      <a
                        href={`/admin/blogs/edit/${blog._id}`}
                        class="block truncate text-sm font-medium no-underline hover:underline"
                      >
                        {blog.title}
                      </a>
                      <span class="text-xs text-muted-foreground">
                        {blog.category} · {formatDate(blog.date)}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </div>
      )
    }
  </div>
</AdminLayout>
