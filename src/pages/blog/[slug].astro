---
import Layout from "@/layouts/Layout.astro";
import NestedNavbar from "@/components/NestedNavbar.astro";
import FullscreenImage from "@/components/ui/FullscreenImage.astro";

export const prerender = false;

const { slug = "" } = Astro.params;

/**
 * This page renders an **instant static shell** — no database work happens
 * while the HTML is being generated. The post, its cover image and the
 * related-posts sidebar are fetched from the public APIs right after paint
 * by the client script at the bottom of this file.
 *
 * The tab title falls back to a prettified slug so it already reads
 * meaningfully before the data arrives.
 */
const fallbackTitle =
  slug
    .split("-")
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ") || "Blog Post";

/** 1×1 transparent placeholder — the hidden cover never requests the page URL. */
const BLANK_PIXEL =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
---

<Layout
  title={fallbackTitle}
  description={`Read ${fallbackTitle} — an article by Mamun Dev.`}
  type="article"
>
  <main data-blog-slug={slug}>
    <div class="mb-4">
      <NestedNavbar prevRoute="/blogs" />
    </div>

    {/* Revealed by the client script when the post is missing or fetching fails. */}
    <div id="blog-status" hidden>
      <div
        class="min-h-[50vh] flex flex-col items-center justify-center text-center"
      >
        <h1 id="blog-status-title" class="text-4xl font-bold mb-4"></h1>
        <p id="blog-status-message" class="text-muted-foreground mb-4"></p>
        <a href="/blogs" class="text-primary hover:underline">View all blogs</a>
      </div>
    </div>

    <div
      id="blog-grid"
      class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px]"
    >
      <article class="min-w-0">
        <div class="mb-6">
          <span id="blog-category" class="text-sm text-muted-foreground">
            <span class="inline-block h-4 w-24 rounded bg-muted animate-pulse">
            </span>
          </span>
          <h1
            id="blog-title"
            class="text-4xl md:text-5xl font-bold mt-2 mb-4"
          >
            {fallbackTitle}
          </h1>
          <p id="blog-date" class="text-muted-foreground">
            <span class="inline-block h-4 w-32 rounded bg-muted animate-pulse">
            </span>
          </p>
        </div>

        {/* Cover — hidden until the fetched post provides a real image. */}
        <div id="blog-image" class="mb-6" hidden>
          <FullscreenImage src={BLANK_PIXEL} alt="" class="object-cover" />
        </div>

        {/* Skeleton bars — replaced by the rendered markdown once fetched. */}
        <div
          id="blog-content"
          class="prose prose-zinc max-w-none"
          aria-busy="true"
        >
          <div class="space-y-4">
            <div class="h-4 w-11/12 rounded bg-muted animate-pulse"></div>
            <div class="h-4 w-full rounded bg-muted animate-pulse"></div>
            <div class="h-4 w-10/12 rounded bg-muted animate-pulse"></div>
            <div class="h-4 w-9/12 rounded bg-muted animate-pulse"></div>
            <div class="h-40 w-full rounded-lg bg-muted animate-pulse mt-8">
            </div>
            <div class="h-4 w-11/12 rounded bg-muted animate-pulse"></div>
            <div class="h-4 w-full rounded bg-muted animate-pulse"></div>
            <div class="h-4 w-8/12 rounded bg-muted animate-pulse"></div>
          </div>
        </div>
      </article>

      <aside id="blog-aside" class="min-w-0">
        <div class="lg:sticky lg:top-24">
          <div class="mb-4 flex items-center justify-between gap-4">
            <h2 id="blog-sidebar-title" class="text-lg font-semibold">
              Related posts
            </h2>
            <a
              href="/blogs"
              class="text-sm font-medium text-primary hover:underline"
            >
              All blogs
            </a>
          </div>
          <div
            id="blog-sidebar"
            class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1"
          >
            {/* Skeleton rows while the sidebar fetch is in flight. */}

            <div
              class="flex items-center gap-3 border border-border bg-white/60 dark:bg-[#141416]/60 backdrop-blur-lg px-2 py-2 animate-pulse"
            >
              <span class="block size-32 shrink-0 rounded-sm bg-muted"></span>
              <span class="min-w-0 flex-1 space-y-2">
                <span class="block h-4 w-3/4 rounded bg-muted"></span>
                <span class="block h-3 w-1/2 rounded bg-muted"></span>
              </span>
            </div>
            <div
              class="flex items-center gap-3 border border-border bg-white/60 dark:bg-[#141416]/60 backdrop-blur-lg px-2 py-2 animate-pulse"
            >
              <span class="block size-32 shrink-0 rounded-sm bg-muted"></span>
              <span class="min-w-0 flex-1 space-y-2">
                <span class="block h-4 w-3/4 rounded bg-muted"></span>
                <span class="block h-3 w-1/2 rounded bg-muted"></span>
              </span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<script>
  import type { BlogType } from "@/types/types";

  /**
   * Adds the copy-to-clipboard button to rendered `<pre>` blocks,
   * replacing the React `CodeBlock` component.
   *
   * Also runs after the client script injects the fetched article, since
   * the buttons are built per `<pre>`.
   */
  const CHECK_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M20 6 9 17l-5-5"/></svg>`;
  const COPY_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;

  function initCopyButtons() {
    document
      .querySelectorAll<HTMLPreElement>(".prose pre:not([data-copy-ready])")
      .forEach((pre) => {
        pre.dataset.copyReady = "true";
        pre.classList.add("overflow-x-auto", "rounded-lg");

        const wrapper = document.createElement("div");
        wrapper.className = "relative group mb-6";
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = [
          "absolute right-2 top-2 p-2 rounded-md w-8 h-8",
          "bg-zinc-700/50 hover:bg-zinc-700 text-zinc-100",
          "opacity-0 transition-opacity duration-200 group-hover:opacity-100",
          "focus:opacity-100 focus:outline-none focus:ring-2 focus:ring-zinc-400",
          "border border-zinc-600/50 backdrop-blur-sm cursor-pointer",
        ].join(" ");
        button.setAttribute("aria-label", "Copy code");
        button.title = "Copy code";
        button.innerHTML = COPY_ICON;

        button.addEventListener("click", async () => {
          const text = pre.innerText.replace(/\n$/, "");
          try {
            await navigator.clipboard.writeText(text);
            button.innerHTML = CHECK_ICON;
            setTimeout(() => {
              button.innerHTML = COPY_ICON;
            }, 2000);
          } catch (err) {
            console.error("Failed to copy text: ", err);
          }
        });

        wrapper.appendChild(button);
      });
  }

  /* ------------------------------------------------------------------ *
   * Client-side data loading — the shell above renders instantly, then
   * this fills it in from the public read-only APIs.
   * ------------------------------------------------------------------ */

  type BlogPayload = {
    success: boolean;
    data?: BlogType & { contentHtml?: string };
  };
  type ListPayload = { success: boolean; data?: BlogType[] };

  const mainEl = document.querySelector<HTMLElement>("main[data-blog-slug]");
  const slug = mainEl?.dataset.blogSlug ?? "";

  const statusEl = document.getElementById("blog-status");
  const statusTitleEl = document.getElementById("blog-status-title");
  const statusMessageEl = document.getElementById("blog-status-message");
  const gridEl = document.getElementById("blog-grid");
  const categoryEl = document.getElementById("blog-category");
  const titleEl = document.getElementById("blog-title");
  const dateEl = document.getElementById("blog-date");
  const imageEl = document.getElementById("blog-image");
  const contentEl = document.getElementById("blog-content");
  const asideEl = document.getElementById("blog-aside");
  const sidebarTitleEl = document.getElementById("blog-sidebar-title");
  const sidebarEl = document.getElementById("blog-sidebar");

  /** Escapes data before it is interpolated into sidebar markup. */
  function esc(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function showStatus(title: string, message: string) {
    if (statusTitleEl) statusTitleEl.textContent = title;
    if (statusMessageEl) statusMessageEl.textContent = message;
    if (gridEl) gridEl.style.display = "none";
    statusEl?.removeAttribute("hidden");
  }

  /** Creates the tag when it is missing (e.g. `article:published_time`). */
  function upsertMeta(
    attr: "name" | "property",
    key: string,
    content: string
  ) {
    const meta = document.head.querySelector<HTMLMetaElement>(
      `meta[${attr}="${key}"]`
    );
    if (meta) {
      meta.setAttribute("content", content);
      return;
    }
    const created = document.createElement("meta");
    created.setAttribute(attr, key);
    created.setAttribute("content", content);
    document.head.appendChild(created);
  }

  /** Keeps the tab title and social/meta tags in sync with the real post. */
  function applyMeta(post: BlogType) {
    const pageTitle = `${post.title} | Mamun Dev`;
    const description = post.excerpt ?? "";

    document.title = pageTitle;
    if (description) {
      upsertMeta("name", "description", description);
      upsertMeta("property", "og:description", description);
      upsertMeta("name", "twitter:description", description);
    }
    upsertMeta("property", "og:title", pageTitle);
    upsertMeta("name", "twitter:title", pageTitle);
    if (post.image) {
      upsertMeta("property", "og:image", post.image);
      upsertMeta("name", "twitter:image", post.image);
    }
    if (post.date) upsertMeta("property", "article:published_time", post.date);
  }

  function renderPost(post: BlogType & { contentHtml?: string }) {
    if (categoryEl) categoryEl.textContent = post.category;
    if (titleEl) titleEl.textContent = post.title;
    if (dateEl) dateEl.textContent = post.date ?? "";

    if (imageEl && post.image) {
      imageEl.querySelectorAll<HTMLImageElement>("img").forEach((img) => {
        img.src = post.image!;
        img.alt = post.title;
      });
      imageEl
        .querySelector(".fullscreen-image")
        ?.setAttribute(
          "aria-label",
          `Open fullscreen view of ${post.title}`
        );
      const modalHeading = imageEl.querySelector("h3");
      if (modalHeading) modalHeading.textContent = `Fullscreen view of ${post.title}`;
      imageEl.removeAttribute("hidden");
    }

    if (contentEl) {
      contentEl.innerHTML = post.contentHtml ?? "";
      contentEl.removeAttribute("aria-busy");
    }

    /* The copy buttons are built per <pre>, so re-run after injection. */
    initCopyButtons();
  }

  /** Placeholder cover used when a post has no image (mirrors SingleBlog). */
  const PLACEHOLDER_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground/40"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`;

  /** Same markup as `<SingleBlog variant="row" />` for the sidebar. */
  function sidebarRow(item: BlogType): string {
    const href = `/blog/${encodeURIComponent(item.slug)}`;
    const cover = item.image
      ? `<img src="${esc(item.image)}" alt="${esc(item.title)}" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />`
      : `<span class="flex h-full w-full items-center justify-center">${PLACEHOLDER_ICON}</span>`;
    const meta = [
      item.category,
      item.date ? `· ${item.date}` : "",
    ].filter(Boolean).join(" ");

    return `<a href="${href}" class="group flex items-center gap-3 border border-border bg-white/60 dark:bg-[#141416]/60 backdrop-blur-lg px-2 py-2 transition-colors hover:bg-accent/50">
      <span class="relative block size-32 border shrink-0 overflow-hidden bg-secondary">${cover}</span>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-sm font-semibold text-foreground group-hover:text-primary group-hover:underline">${esc(item.title)}</span>
        <span class="mt-0.5 block text-xs text-muted-foreground">${esc(meta)}</span>
      </span>
    </a>`;
  }

  /**
   * Mirrors the old server-side related-posts logic: same category first,
   * then newest, de-duplicated and never the current post.
   */
  async function loadRelated(post: BlogType) {
    try {
      const [sameRes, allRes] = await Promise.all([
        fetch(`/api/blogs?category=${encodeURIComponent(post.category)}`),
        fetch("/api/blogs"),
      ]);
      if (!sameRes.ok || !allRes.ok) throw new Error("Sidebar request failed");

      const samePayload = (await sameRes.json()) as ListPayload;
      const allPayload = (await allRes.json()) as ListPayload;
      if (!samePayload.success || !allPayload.success) {
        throw new Error("Sidebar request failed");
      }

      const sameCategory = (samePayload.data ?? [])
        .filter((item) => item.slug !== slug)
        .slice(0, 4);
      const newest = (allPayload.data ?? [])
        .filter((item) => item.slug !== slug)
        .slice(0, 4);

      const seen = new Set<string>();
      const related = [...sameCategory, ...newest].filter((item) => {
        const key = item.slug || String(item._id ?? "");
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });

      const items = related.length > 0 ? related : newest;
      if (items.length === 0) {
        asideEl?.setAttribute("hidden", "");
        return;
      }

      if (sidebarTitleEl) {
        sidebarTitleEl.textContent =
          related.length > 0 ? "Related posts" : "Latest posts";
      }
      if (sidebarEl) sidebarEl.innerHTML = items.map(sidebarRow).join("");
    } catch (error) {
      console.error("Error loading related posts:", error);
      asideEl?.setAttribute("hidden", "");
    }
  }

  async function load() {
    if (!slug) {
      showStatus(
        "Post not found",
        "The blog post you are looking for does not exist."
      );
      return;
    }

    try {
      const response = await fetch(`/api/blogs/${encodeURIComponent(slug)}`, {
        headers: { Accept: "application/json" },
      });

      /* Matches the old server-side 404 rewrite, just after first paint. */
      if (response.status === 404) {
        showStatus(
          "Post not found",
          "The blog post you are looking for does not exist."
        );
        return;
      }
      if (!response.ok) {
        throw new Error(`Failed to fetch blog post (${response.status})`);
      }

      const payload = (await response.json()) as BlogPayload;
      if (!payload.success || !payload.data) {
        showStatus(
          "Post not found",
          "The blog post you are looking for does not exist."
        );
        return;
      }

      applyMeta(payload.data);
      renderPost(payload.data);
      void loadRelated(payload.data);
    } catch (error) {
      console.error("Error loading blog:", error);
      showStatus(
        "Error Loading Blog",
        "There was an error loading this blog post."
      );
    }
  }

  initCopyButtons();
  document.addEventListener("astro:page-load", initCopyButtons);
  void load();
</script>
